# ---------------------------------------------------------------
# SuppPOS — environment variables (ALL SERVER-ONLY).
# Never add a VITE_ prefix: the browser must never receive these.
# Each deployment (your test site, each client) uses its own values.
# Never commit real values; set them in Vercel -> Settings -> Environment Variables.
# ---------------------------------------------------------------

# libsql://<db-name>-<org>.turso.io   (a local libSQL server, e.g. http://127.0.0.1:8080, for testing)
TURSO_DATABASE_URL=
# turso db tokens create <db-name>   (leave empty only for a local test server without auth)
TURSO_AUTH_TOKEN=
# 32+ random characters, unique per deployment. Signs/encrypts login cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=
